@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(YomkServer)

include("${CMAKE_CURRENT_LIST_DIR}/YomkRpcTargets.cmake")

set_and_check(YomkRpc_INCLUDE_DIRS "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(YomkRpc_LIB_DIR "@PACKAGE_LIB_INSTALL_DIR@")
set(YomkRpc_LIBRARIES YomkRpc::YomkRpc)
set(YomkRpc_VERSION "@PROJECT_VERSION@")
